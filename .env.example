# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Onde achar: painel do Supabase > Project Settings > API Keys (e Data API para a URL).
# NUNCA coloque a service_role / secret key aqui: tudo que começa com NEXT_PUBLIC_ vai para o navegador.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...). A chave "anon" antiga (eyJ...) também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
