# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Onde achar: painel do Supabase > Project Settings > API Keys (e Data API para a URL).
# Tudo que começa com NEXT_PUBLIC_ vai para o navegador: só chaves públicas com esse prefixo.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...). A chave "anon" antiga (eyJ...) também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave SECRETA (sb_secret_...), em Project Settings > API Keys > Secret keys.
# Só o servidor usa, para mandar os avisos no celular. NUNCA com NEXT_PUBLIC_,
# nunca no GitHub, nunca em print. Sem ela o site funciona, mas não manda avisos.
SUPABASE_SECRET_KEY=

# Avisos no celular (Web Push). Gere as duas chaves UMA vez com:
#   npx web-push generate-vapid-keys
# A pública pode ir para o navegador. A privada fica só no servidor (sem NEXT_PUBLIC_).
# Se trocar as chaves depois, todo mundo precisa ligar os avisos de novo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato que vai junto com o aviso para o Google/Apple (seu e-mail com mailto:).
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Endereço público do site (para o Google e a prévia do link no WhatsApp).
# Na Vercel: o domínio final, ex.: https://vaidecorte.vercel.app
NEXT_PUBLIC_SITE_URL=
